
<div class="mockbar"><div class="mockbar-in">
  <strong style="color:var(--ink)" id="mockName">モック</strong>
  <label for="who" id="whoWrap">ログイン中：<select id="who"></select></label>
  <span class="mocknote">見た目と流れを確かめるためのモックです。保存やTodoistへの送信はしません。表示している案件や金額は例です。</span>
</div></div>

<div class="app">
  <header class="top">
    <div class="brand"><h1>LANDEX BEACON</h1><small>L-BEACON</small></div>
    <div class="who" id="whoLine"></div>
    <nav class="tabs" role="tablist" id="tabs"></nav>
  </header>
  <main id="main"></main>
</div>
<div class="bottom" id="bottom" hidden><div class="bottom-in" id="bottomIn"></div></div>

<script>
const CFG=/*CONFIG*/;
const PEOPLE={
  hakkaku:{name:"八角",dept:"営業部",project:"営業部"},
  iwata:{name:"岩田",dept:"営業部",project:"営業部"},
  mikawa:{name:"三川",dept:"総務部",project:"総務部"},
  mori:{name:"森",dept:"総務部",project:"総務部"},
  oono:{name:"大野",dept:"管理部",project:"管理部【大野】"},
  fujiwara:{name:"藤原",dept:"管理部（執行役員）",project:"管理部【藤原】"},
  mukai:{name:"向井",dept:"不動産事業部",project:"不動産事業部"},
  fujimoto:{name:"藤本",dept:"社長",project:"BEACONテスト",admin:true}
};
const KINDS=[["判断","社長に決めてもらう"],["確認","内容を見てOKをもらう"],["共有のみ","知らせるだけ。Todoistには起票しない"]];
const SAMPLE=w=>CFG.samples[w]||CFG.samples[CFG.people[0]];

let daily={};
let state={who:CFG.people[0],tab:CFG.startTab||"write",step:"form",filter:"all",consults:[],progress:1,openAns:null,boss:"reports"};
function newConsult(seed){return Object.assign({kind:"判断",what:"",to:"",bg:"",due:"",link:""},seed||{});}
function resetForm(){state.consults=SAMPLE(state.who).consults.map(c=>newConsult(c));state.progress=1;state.step="form";daily={};}
resetForm();

const $=s=>document.querySelector(s);
const esc=s=>String(s).replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
const me=()=>PEOPLE[state.who];
const form=()=>CFG.forms[state.who]||CFG.form;
const TODAY=new Date(2026,9,15);
const WD="日月火水木金土";
const jdate=d=>`${d.getFullYear()}年${d.getMonth()+1}月${d.getDate()}日（${WD[d.getDay()]}）`;
const sdate=d=>`${d.getFullYear()}/${String(d.getMonth()+1).padStart(2,"0")}/${String(d.getDate()).padStart(2,"0")}`;
function nextBiz(d){const x=new Date(d);do{x.setDate(x.getDate()+1)}while(x.getDay()===0||x.getDay()===6);return x;}

function initBar(){
  $("#mockName").textContent=CFG.mockName;
  if(CFG.people.length<2){$("#whoWrap").innerHTML=`ログイン中：${esc(PEOPLE[CFG.people[0]].name)}さん`;return;}
  $("#who").innerHTML=CFG.people.map(k=>`<option value="${k}">${esc(PEOPLE[k].name)}さん</option>`).join("");
  $("#who").addEventListener("change",e=>{state.who=e.target.value;state.openAns=null;resetForm();render();});
}
function tabsFor(){const t=[["write","報告を書く"],["mine","自分の相談"],["detail","報告の詳細"]];if(me().admin)t.push(["boss","社長用"]);return t;}
function renderShell(){
  const p=me();
  $("#whoLine").innerHTML=`${esc(p.name)}さん　<span class="tag dept" style="background:rgba(255,255,255,.14);color:#fff">${esc(p.dept)}</span>`+(p.admin?`　<span style="font-size:11px">テストは「BEACONテスト」プロジェクトに起票</span>`:"");
  $("#tabs").innerHTML=tabsFor().map(([k,l])=>`<button role="tab" aria-selected="${state.tab===k}" data-tab="${k}">${l}</button>`).join("");
}
function render(){renderShell();({write:renderWrite,mine:renderMine,detail:renderDetail,boss:renderBoss})[state.tab]();}

/* ---------- 報告を書く ---------- */
function renderWrite(){
  if(state.step==="confirm")return renderConfirm();
  if(state.step==="sent")return renderSent();
  const f=form(),s=SAMPLE(state.who);
  let h=`<div class="date">${jdate(TODAY)}<span class="sub">${esc(f.label)}</span></div>`;
  if(s.note)h+=`<div class="sharenote">${esc(s.note)}</div>`;
  h+=`<div class="sec-title"><h2>日報</h2><span>空欄の項目は送られません</span></div>
  <section class="card">`+f.fields.map(x=>`<div class="field"><label for="d_${x.id}">【${esc(x.t)}】</label>${x.hint?`<span class="hint">${esc(x.hint)}</span>`:""}<textarea id="d_${x.id}" placeholder="${esc((s.ph||{})[x.id]||x.ph||"")}"></textarea></div>`).join("");
  if(f.progress){
    const pg=f.progress,ex=s.progress||pg;
    h+=`<div class="field"><span class="lbl">【${esc(pg.t)}】<span class="opt">案件ごとに1件</span></span>`;
    for(let i=0;i<state.progress;i++)h+=`<div class="progress-item"><input type="text" id="pg_n${i}" placeholder="${esc(pg.name)}（例：${esc(ex.nph)}）"><textarea id="pg_b${i}" placeholder="${esc(ex.bph)}" style="min-height:64px"></textarea></div>`;
    h+=`<button class="linkbtn" data-act="addprog" style="align-self:flex-start">＋案件を追加</button></div>`;
  }
  h+=`</section>
  <div class="sec-title"><h2>社長への確認・相談</h2><span>1件ずつ入力</span></div>`;
  state.consults.forEach((c,i)=>{h+=consultCard(c,i)});
  h+=`<button class="addbtn" data-act="addc">＋相談を追加</button>
  <p class="hint">続きの話は、新しい相談にせず「自分の相談」から続報を出してください。</p>`;
  $("#main").innerHTML=h;
  Object.keys(daily).forEach(k=>{const el=document.getElementById(k);if(el)el.value=daily[k];});
  setBottom(`<button class="btn primary" data-act="toconfirm">内容を確認する</button>`);
}
function consultCard(c,i){
  const share=c.kind==="共有のみ";
  return `<section class="card" data-ci="${i}">
    <div class="consult-head"><h3>相談 ${i+1}</h3><button class="linkbtn" data-act="delc" data-i="${i}">この相談を消す</button></div>
    <div class="field"><span class="lbl">種類</span>
      <div class="seg" role="group" aria-label="相談の種類">${KINDS.map(([k])=>`<button aria-pressed="${c.kind===k}" data-act="kind" data-i="${i}" data-k="${k}">${k}</button>`).join("")}</div>
      <span class="hint">${esc(KINDS.find(k=>k[0]===c.kind)[1])}</span></div>
    ${share?`<div class="sharenote">共有のみは記録だけ残ります。社長の回答待ちにはなりません。</div>`:""}
    <div class="field"><label for="c_what${i}">${share?"何を知らせるか":"何を決めてほしいか"}<span class="req">必須</span></label>
      <input type="text" id="c_what${i}" data-k="what" data-i="${i}" value="${esc(c.what)}" placeholder="1行で書いてください">
      <span class="hint">${share?"記録の見出しになります":"1行で。Todoistのタイトルになります"}</span></div>
    <div class="field"><label for="c_to${i}">相手先・件名<span class="opt">推奨</span></label>
      <input type="text" id="c_to${i}" data-k="to" data-i="${i}" value="${esc(c.to)}" placeholder="例：○○様／船橋市 確定測量"></div>
    <div class="field"><label for="c_bg${i}">背景・事実<span class="opt">推奨：金額・日付・相手の名前</span></label>
      <textarea id="c_bg${i}" data-k="bg" data-i="${i}" placeholder="経緯、金額、日付、相手の名前など">${esc(c.bg)}</textarea></div>
    <div class="row2">
      <div class="field"><label for="c_due${i}">期限<span class="opt">任意</span></label>
        <input type="date" id="c_due${i}" data-k="due" data-i="${i}" value="${esc(c.due)}">
        ${share||c.due?"":`<span class="hint">空欄なら ${sdate(nextBiz(TODAY))}（翌営業日）を仮期限にします</span>`}</div>
      <div class="field"><label for="c_link${i}">資料のリンク<span class="opt">任意</span></label>
        <input type="url" id="c_link${i}" data-k="link" data-i="${i}" value="${esc(c.link)}" placeholder="Googleドライブのリンク"></div>
    </div>
  </section>`;
}

function taskTitle(c,p){return `${c.to?`[${c.to}] `:""}${c.what||"（未入力）"}（${p.name}さん）`;}
function taskDesc(c,p,id){
  const due=c.due?c.due.replace(/-/g,"/"):`${sdate(nextBiz(TODAY))}（報告に期限の記載なし → 仮期限）`;
  return `【何を判断するか／担当：藤本さん】\n${c.what}\n【種類】${c.kind}\n【背景】\n${c.bg||"（記載なし）"}\n【誰に返すか】${p.name}さん\n【期限】${due}\n【資料】${c.link||"なし"}\n【出典】BEACON ${sdate(TODAY)} ${p.name}\nhttps://script.google.com/a/macros/landex-ltd.com/s/…/exec?r=${id}`;
}
function renderConfirm(){
  const p=me();
  let h=`<div class="date">送る前の確認</div>
  <p class="hint">下の内容で記録し、相談はTodoistの「${esc(p.project)}」の📥社長がやる に起票します。</p>`;
  const bad=state.consults.filter(c=>!c.what.trim());
  if(bad.length)h+=`<div class="inline-confirm">1行目が空の相談が${bad.length}件あります。戻って入力してください。</div>`;
  state.consults.forEach((c,i)=>{
    const id=`R20261015-004`;
    if(c.kind==="共有のみ"){h+=`<div class="preview"><div class="preview-h"><span>相談 ${i+1}：共有のみ</span><span>Todoistには起票しません</span></div><div class="preview-b"><div class="ptitle">${esc(c.what)}</div><div class="c-meta">${esc(c.to)}</div></div></div>`;return;}
    h+=`<div class="preview"><div class="preview-h"><span>相談 ${i+1}：Todoistに起票される形</span><span>${esc(p.project)} ／ 📥社長がやる</span></div>
      <div class="preview-b"><div class="ptitle">${esc(taskTitle(c,p))}</div>
      <div class="meta"><span>ラベル <b>📥社長がやる</b></span><span>優先度 <b>p1</b></span><span>担当 <b>藤本</b></span><span>期限 <b>${c.due?c.due.replace(/-/g,"/"):sdate(nextBiz(TODAY))}</b></span></div>
      <pre class="desc">${esc(taskDesc(c,p,id))}</pre></div></div>`;
  });
  $("#main").innerHTML=h;
  setBottom(`<button class="btn ghost" data-act="back">戻って直す</button><button class="btn primary" data-act="send" ${bad.length?"disabled style='opacity:.5'":""}>報告を送る</button>`);
}
function renderSent(){
  const n=state.consults.filter(c=>c.kind!=="共有のみ").length,sh=state.consults.length-n;
  $("#main").innerHTML=`<div class="card done-msg"><div class="mark">送信しました</div>
    <div>日報を記録し、相談${n}件をTodoistの📥社長がやる に起票しました。${sh?`共有${sh}件は記録だけ残しました。`:""}</div>
    <div class="hint">報告ID R20261015-004　／　回答は「自分の相談」で見られます</div></div>
    <div class="card"><div class="c-top"><span class="status fail">起票失敗の例</span></div>
    <div style="font-size:14px">Todoistにつながらず起票できなかった場合は、ここに表示し、藤本さんにもメールで知らせます。報告そのものは保存されています。</div></div>`;
  setBottom(`<button class="btn ghost" data-act="tomine">自分の相談を見る</button><button class="btn primary" data-act="again">新しい報告を書く</button>`);
}

/* ---------- 自分の相談 ---------- */
const ST={wait:["回答待ち","wait"],ans:["回答あり","ans"],done:["完了","done"]};
function renderMine(){
  const MINE=SAMPLE(state.who).mine;
  const cnt=k=>k==="all"?MINE.length:MINE.filter(m=>m.st===k).length;
  let h=`<div class="filters">${[["all","すべて"],["ans","回答あり"],["wait","回答待ち"],["done","完了"]].map(([k,l])=>`<button class="chip" aria-pressed="${state.filter===k}" data-act="filter" data-f="${k}">${l}<span class="n">${cnt(k)}</span></button>`).join("")}</div>
  <p class="hint">状態はTodoistから読み込んでいます（最終更新 10:05）。</p>`;
  MINE.filter(m=>state.filter==="all"||m.st===state.filter).forEach(m=>{
    h+=`<section class="card"><div class="c-top"><span class="status ${ST[m.st][1]}">${ST[m.st][0]}</span>
      <span class="c-meta">${m.date} 提出 ／ 期限 ${m.due}${m.overdue&&m.st!=="done"?` <span class="tag urgent">期限超過</span>`:""}</span></div>
      <div class="c-title">${esc(m.title)}</div>`;
    if(m.thread.length)h+=`<div class="thread">${m.thread.map(x=>`<div class="cmt ${x.c}"><div class="who">${esc(x.who)}</div>${esc(x.t)}</div>`).join("")}</div>`;
    if(m.st!=="done"){
      h+=state.openAns===m.id+"f"?`<div class="field"><label for="fu_${m.id}">続報</label>
        <textarea id="fu_${m.id}" placeholder="社長の回答を受けての対応、追加の事実など"></textarea>
        <span class="hint">「【続報：BEACON ${sdate(TODAY)} ${me().name}】」を先頭に付けてTodoistにコメントします。${m.st==="ans"?"このタスクは📥社長がやる に戻ります。":"すでに📥社長がやる にあるので、場所は変わりません。"}</span></div>
        <div class="actions"><button class="btn ghost small" data-act="close">やめる</button><button class="btn primary small" data-act="close">続報を出す</button></div>`
      :state.openAns===m.id+"c"?`<div class="inline-confirm">この相談を「完了」にします。Todoistのタスクもチェックされます。よろしいですか？
        <div class="actions"><button class="btn ghost small" data-act="close">やめる</button><button class="btn vermilion small" data-act="close">完了にする</button></div></div>`
      :`<div class="actions"><button class="btn ghost small" data-act="openc" data-id="${m.id}">完了にする</button><button class="btn primary small" data-act="openf" data-id="${m.id}">続報を出す</button></div>`;
    }
    h+=`</section>`;
  });
  $("#main").innerHTML=h;setBottom(null);
}

/* ---------- 報告の詳細（出典リンクの行き先） ---------- */
function renderDetail(){
  const s=SAMPLE(state.who),d=s.detail,p=me();
  $("#main").innerHTML=`<div class="date">${esc(d.date)}<span class="sub">${esc(p.name)}さん・${esc(form().label)}</span></div>
  <p class="hint">Todoistの【出典】リンクから開く画面です（報告ID ${esc(d.id)}）。</p>
  <section class="card daily-view"><dl style="margin:0">${d.daily.map(([t,b])=>`<dt>【${esc(t)}】</dt><dd>${esc(b)}</dd>`).join("")}</dl></section>
  <div class="sec-title"><h2>相談</h2><span>${d.consults.length}件</span></div>
  ${d.consults.map(i=>s.mine[i]).map(m=>`<section class="card"><div class="c-top"><span class="status ${ST[m.st][1]}">${ST[m.st][0]}</span><span class="tag kind">${m.kind}</span></div><div class="c-title">${esc(m.title)}</div><div class="c-meta">TodoistタスクID 88123450${m.id.slice(1)}　<a href="#" style="color:var(--dept)">Todoistで開く</a></div></section>`).join("")}`;
  setBottom(null);
}

/* ---------- 社長用 ---------- */
function renderBoss(){
  const rep=[["10/15 8:50","岩田","営業部","続報1件","—"],["10/14 18:10","藤原","管理部","日報＋相談1","起票済"],["10/14 18:02","大野","管理部","日報＋相談3","1件失敗"],["10/14 17:58","向井","不動産事業部","日報＋相談1","起票済"],["10/14 17:55","八角","営業部","日報＋相談1＋共有1","起票済"],["10/14 17:54","岩田","営業部","日報＋相談1","起票済"],["10/14 12:57","森","総務部","日報＋相談1","起票済"],["10/13 15:10","三川","総務部","日報＋共有1","—"]];
  $("#main").innerHTML=`<div class="filters">${[["reports","全員の報告"],["fails","起票の失敗"]].map(([k,l])=>`<button class="chip" aria-pressed="${state.boss===k}" data-act="boss" data-b="${k}">${l}${k==="fails"?`<span class="n">1</span>`:""}</button>`).join("")}</div>`+
  (state.boss==="reports"?`<section class="card"><div class="tbl-wrap"><table><thead><tr><th>日時</th><th>報告者</th><th>部署</th><th>内容</th><th>起票</th></tr></thead><tbody>
    ${rep.map(r=>`<tr><td class="num">${r[0]}</td><td>${r[1]}</td><td><span class="tag dept">${r[2]}</span></td><td>${r[3]}</td><td>${r[4]==="1件失敗"?`<span class="status fail">${r[4]}</span>`:r[4]}</td></tr>`).join("")}</tbody></table></div>
    <p class="hint" style="margin:0">見るだけの画面です。回答はこれまでどおりClaudeの社長回答コメントスキルで行います。</p></section>`
  :`<section class="card"><div class="c-top"><span class="status fail">起票失敗</span><span class="c-meta">10/14 18:02 大野さん</span></div>
    <div class="c-title">[銀行／給与振込] 振込限度額を銀行で変更してよいか（大野さん）</div>
    <pre class="desc">Todoist API 503 Service Unavailable（3回再試行して失敗）</pre>
    <div class="actions"><button class="btn primary small">もう一度起票する</button></div></section>`);
  setBottom(null);
}

function setBottom(html){const b=$("#bottom");if(!html){b.hidden=true;return;}b.hidden=false;$("#bottomIn").innerHTML=html;}

document.addEventListener("click",e=>{
  const t=e.target.closest("[data-tab],[data-act]");if(!t)return;
  if(t.dataset.tab){state.tab=t.dataset.tab;state.openAns=null;render();window.scrollTo(0,0);return;}
  const a=t.dataset.act,i=+t.dataset.i;
  if(a==="addc")state.consults.push(newConsult());
  else if(a==="delc")state.consults.splice(i,1);
  else if(a==="kind")state.consults[i].kind=t.dataset.k;
  else if(a==="addprog")state.progress++;
  else if(a==="toconfirm"){state.step="confirm";window.scrollTo(0,0);}
  else if(a==="back")state.step="form";
  else if(a==="send"){if(t.disabled)return;state.step="sent";window.scrollTo(0,0);}
  else if(a==="again")resetForm();
  else if(a==="tomine"){state.tab="mine";resetForm();}
  else if(a==="filter")state.filter=t.dataset.f;
  else if(a==="openf")state.openAns=t.dataset.id+"f";
  else if(a==="openc")state.openAns=t.dataset.id+"c";
  else if(a==="close")state.openAns=null;
  else if(a==="boss")state.boss=t.dataset.b;
  else return;
  e.preventDefault();render();
});
document.addEventListener("input",e=>{const el=e.target;if(/^(d_|pg_)/.test(el.id))daily[el.id]=el.value;if(el.dataset.k&&el.dataset.i!==undefined&&state.consults[+el.dataset.i])state.consults[+el.dataset.i][el.dataset.k]=el.value;});
document.addEventListener("change",e=>{if(e.target.dataset.k==="due"&&state.tab==="write")render();});
initBar();render();
</script>
